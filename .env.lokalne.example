# Nastavení pro spouštění na vlastním počítači bez Dockeru (SQLite).
# Zkopírujte jako .env:   copy .env.lokalne.example .env
# Pak už není potřeba psát "set ..." v každém novém okně.
# .env NIKDY nepatří do gitu. Jen syntetická data, žádní skuteční sportovci.

DJANGO_SECRET_KEY=jen-na-prohlednuti
DATABASE_URL=sqlite:///db.sqlite3

# Lokální jazykový model (LM Studio se zapnutým serverem).
# Název modelu zjistíte příkazem: python manage.py llm_check
LLM_ENABLED=True
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-e4b
