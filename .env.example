# Zkopírujte jako .env a doplňte hodnoty. .env NIKDY nepatří do gitu.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=zmente-me-na-nahodny-retezec
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (hostname "db" odpovídá službě v docker-compose.yml)
DATABASE_URL=postgres://ftvs:ftvs@db:5432/ftvs

# Klíč pro šifrování oddělené identity (jméno, příjmení, kontakt).
# Vygenerujete: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# V produkci NESMÍ být uložený vedle databáze.
IDENTITY_ENCRYPTION_KEY=
# Klíč pro šifrování genotypů (genetika) – jiný než klíč identity; doplní ho
# "python manage.py zajisti_klic". Bez něj se genotypy neukládají.
GENETICS_ENCRYPTION_KEY=

# Nahrané soubory (exporty, PDF, souhlasy) se ukládají na disk do ./media.

# Veřejná adresa aplikace do e-mailů posílaných mimo prohlížeč (připomínky
# dalšího měření z příkazu pripomenout_mereni), např. https://ftvs.pythonanywhere.com
PUBLIC_BASE_URL=


# Sledovaná složka s exporty z přístroje (VALD Hub ukládá exporty do složky).
# Když je vyplněná, spustit.bat ji hlídá: nový export se sám načte do Importu
# a když aplikace sportovce jednoznačně pozná a má naplánovaný testovací den,
# rovnou se uloží. Ostatní čekají na kontrolu v Importu.
# Windows: IMPORT_WATCH_DIR=C:\Users\laborator\Documents\VALD exporty
IMPORT_WATCH_DIR=
# Jak často se složka kontroluje (sekundy).
IMPORT_WATCH_INTERVAL=30

# Denní údržba (spouští ji spustit.bat ve vlastním okně, na serveru plánovaná
# úloha "manage.py udrzba --jednou"): záloha databáze, nahraných souborů a .env
# do složky BACKUP_DIR/denni (prázdné = Zalohy-FTVS ve vašem profilu), úklid
# starých nedokončených importů, připomínky měření a jednou týdně e-mail
# správci se stavem pracoviště. Kolik denních záloh nechat a který den
# v týdnu posílat stav (0 = pondělí … 6 = neděle).
BACKUP_DIR=
BACKUP_KEEP_DAILY=7
STATUS_MAIL_WEEKDAY=0
# Pojistka: když příkaz udrzba neběží, údržbu spustí první otevření Přehledu
# v daný den (False = jen příkaz).
MAINTENANCE_IN_WEB=True
