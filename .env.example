# Zkopírujte jako .env a doplňte hodnoty. .env NIKDY nepatří do gitu.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=zmente-me-na-nahodny-retezec
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (hostname "db" odpovídá službě v docker-compose.yml)
DATABASE_URL=postgres://ftvs:ftvs@db:5432/ftvs

# Klíč pro šifrování oddělené identity (jméno, příjmení, kontakt).
# Vygenerujete: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# V produkci NESMÍ být uložený vedle databáze.
IDENTITY_ENCRYPTION_KEY=

# Nahrané soubory (exporty, PDF, souhlasy) se ukládají na disk do ./media.
