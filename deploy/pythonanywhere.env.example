# Šablona souboru .env pro ukázku na PythonAnywhere.
# Zkopírujte jako ~/Aplikace_data/.env a JMENO nahraďte svým
# uživatelským jménem. Soubor .env do gitu nepatří (je v .gitignore).

DJANGO_SECRET_KEY=VLOZTE_VYGENEROVANY_KLIC
DJANGO_ALLOWED_HOSTS=JMENO.eu.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://JMENO.eu.pythonanywhere.com
DATABASE_URL=sqlite:////home/JMENO/Aplikace_data/db.sqlite3

# Ukázkový režim: varovný pruh a vypnuté nahrávání souborů.
DEMO_MODE=True
DEMO_ADMIN_PASSWORD=ZVOLTE_DLOUHE_HESLO

# HTTPS vynucuje PythonAnywhere sám (Web → Force HTTPS), aplikace
# přesměrovávat nemusí.
DJANGO_SECURE_SSL_REDIRECT=False
