# Šablona souboru .env pro ukázku na PythonAnywhere.
# Zkopírujte jako ~/Aplikace_data/.env a JMENO nahraďte svým
# uživatelským jménem. Soubor .env do gitu nepatří (je v .gitignore).

DJANGO_SECRET_KEY=VLOZTE_VYGENEROVANY_KLIC
DJANGO_ALLOWED_HOSTS=JMENO.eu.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://JMENO.eu.pythonanywhere.com
DATABASE_URL=sqlite:////home/JMENO/Aplikace_data/db.sqlite3
# Disk na PythonAnywhere je síťový – režim WAL by tu mohl ztratit data.
SQLITE_WAL=False

# Zkušební provoz: varovný pruh, ukázková data a reset; jinak vše jako v laboratoři.
DEMO_MODE=True
DEMO_ADMIN_PASSWORD=ZVOLTE_DLOUHE_HESLO

# HTTPS vynucuje PythonAnywhere sám (Web → Force HTTPS), aplikace
# přesměrovávat nemusí.
DJANGO_SECURE_SSL_REDIRECT=False

# Jazykový model ve zkušebním provozu: cloudový Gemini přes rozhraní
# kompatibilní s OpenAI, klíč z Google AI Studia (bez zapnutého placení).
# Souhrny tak opouštějí pracoviště – proto sem patří jen smyšlená data;
# mimo zkušební provoz (DEMO_MODE=False) aplikace cloudový model odmítne.
# Název modelu vyberte v aplikaci: AI zprávy → Modely.
# LLM_ENABLED=True
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=VLOZTE_KLIC_Z_AI_STUDIA
# LLM_MODEL=gemini-2.5-flash
# LLM_BACKGROUND=False
# LLM_TIMEOUT=90
