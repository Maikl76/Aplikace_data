# Nastavení aplikace na serveru. nainstalovat-vydani.sh ho při první
# instalaci zkopíruje do /opt/ftvs/.env a sám doplní hesla a klíče.
# Ručně vyplňte jen FTVS_HOST (adresa serveru) a případně certifikát.

# --- adresa ------------------------------------------------------------
FTVS_HOST=__HOST__
DJANGO_ALLOWED_HOSTS=__HOST__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__HOST__
# Certifikát od IT: soubory do /opt/ftvs/certs a odkomentovat.
#FTVS_TLS=/certs/cert.pem /certs/key.pem

# --- tajné hodnoty (doplní instalace, NEMĚNIT) -------------------------
DJANGO_SECRET_KEY=__SECRET__
DB_PASSWORD=__DBPASS__
DATABASE_URL=postgres://ftvs:__DBPASS__@db:5432/ftvs
# Klíč k šifrovaným jménům. Bez něj jména nejdou přečíst – zálohujte ho
# zvlášť (ne na stejný disk jako zálohy databáze).
IDENTITY_ENCRYPTION_KEY=__IDKEY__

# --- AI (zapne nainstalovat-vydani.sh --ai) ------------------------------
LLM_ENABLED=False
LLM_BASE_URL=http://llm:11434/v1
LLM_MODEL=gemma3:4b

# --- e-maily (fakultní poštovní server, pokud je v síti dostupný) --------
#EMAIL_HOST=
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=Laboratoř FTVS <diagnostika@ftvs.cuni.cz>
